# 本地复制为 .env.local；只填自己环境的真实值，切勿提交到 Git。
# Neon 连接池地址供网页运行；数据库密码与演示登录口令是两套配置。
# 若密码含 @、:、/ 等 URL 特殊字符，须先进行 URL 编码。
DATABASE_URL="postgresql://user:replace-with-password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# 迁移、Seed 和维护走直连；Vercel Neon 若已提供 DATABASE_URL_UNPOOLED 可直接使用，不必重复配置 DIRECT_URL。
DIRECT_URL="postgresql://user:replace-with-password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
# 本机 PostgreSQL 无连接池时两者可用同一个 localhost 地址。
# Auth.js 用此密钥签署会话；它不用于连接数据库。
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Seed 用此口令生成演示用户的 passwordHash；网页便捷登录也在服务端读取它。
DEMO_PASSWORD="replace-with-a-local-demo-password"
# 仅可信任的本地 npm run start 预览需要；Vercel 会提供自己的可信主机信号。
# AUTH_TRUST_HOST="true"
# 手动恢复时才设置专用演示库名；完整命令见 specs/004-deployment/quickstart.md。
# DEMO_RESET_DATABASE="neondb"
