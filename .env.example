# 本地复制为 .env.local；只填自己环境的真实值，切勿提交到 Git。
# DATABASE_URL 中冒号前是应用专用数据库用户名，冒号后是该账号密码；不是 MySQL 管理员密码，也不是网页登录密码。
# 若密码含 @、:、/ 等 URL 特殊字符，须先进行 URL 编码。
DATABASE_URL="mysql://simeval_user:replace-with-local-password@127.0.0.1:3306/simeval_dev"
# Auth.js 用此密钥签署会话；它不用于连接 MySQL。
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Seed 用此口令生成演示用户的 passwordHash；网页便捷登录也在服务端读取它。
DEMO_PASSWORD="replace-with-a-local-demo-password"
# 仅可信任的本地 npm run start 预览需要；Vercel 会提供自己的可信主机信号。
# AUTH_TRUST_HOST="true"
